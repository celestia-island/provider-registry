__pycache__/
*.py[cod]

/target

# celestia-devtools: staged-on-demand shared justfile recipes (celestia-devtools init / just fetch)
/.just/
/celestia-devtools.just

# Generated catalog artifact (scripts/build_catalog_index.py). The publish
# workflow rebuilds it from the TOML tree on every push to master and uploads it
# to the rolling `catalog-latest` release; it is never committed.
/dist/

# Local/CI Python environment. `catalog-validate.yml` creates it inside the
# checkout when the runner's python3 has no `toml` wheel (PEP 668 forbids the
# system env), so it must never show up as an untracked change.
/.venv/
